# Copy to app/.env if you want a default. The shell wins over this file.
# One-command switches (no .env required):
#   npm run desk:localnet
#   npm run desk:devnet

SCARDESK_NETWORK=devnet
# SCARDESK_RPC=https://solana-devnet.api.onfinality.io/public
# PYTH_API_KEY=
# Leave SCARDESK_ALLOW_MAINNET unset. This desk settles demo stable.
# Leave SCARDESK_ACTIVATE unset. It rewrites deployment.json.
